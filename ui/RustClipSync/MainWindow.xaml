<Window x:Class="RustClipSync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RustClipSync">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,18,24,10">
   <Image Source="Assets/rustclipsync.png" Width="36" Height="36" AutomationProperties.Name="RustClipSync 图标"/>
   <TextBlock Text="RustClipSync" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </StackPanel>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="HomeNav" Content="主页" Icon="Home" Tag="home" AutomationProperties.AutomationId="NavHome"/>
    <NavigationViewItem x:Name="AppearanceNav" Content="外观" Tag="appearance" AutomationProperties.AutomationId="NavAppearance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="SettingsNav" Content="设置" Icon="Setting" Tag="settings" AutomationProperties.AutomationId="NavSettings"/>
   </NavigationView.MenuItems>
   <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="24,16,24,24" MaxWidth="840" HorizontalAlignment="Stretch" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>
     <Grid Grid.Row="1">
      <StackPanel x:Name="HomePage" Spacing="16">
       <StackPanel Spacing="8">
        <TextBlock x:Name="StateText" Text="后台未启动" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AutomationId="SyncState"/>
        <TextBlock x:Name="ServerText" Text="服务端：尚未配置" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="DeviceText" IsTextSelectionEnabled="True" Text="设备：尚未配对" Style="{StaticResource Note}"/>
        <TextBlock x:Name="LastSyncText" Text="最近同步：本次运行尚未同步" Style="{StaticResource Note}"/>
        <TextBlock x:Name="PendingText" Text="有待发送或待确认的内容" Style="{StaticResource Note}" Visibility="Collapsed"/>
       </StackPanel>
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="PushButton" Content="发送" HorizontalAlignment="Stretch" Click="Push_Click" IsEnabled="False" AutomationProperties.AutomationId="PushNow"/>
        <Button x:Name="PullButton" Grid.Column="1" Content="接收" HorizontalAlignment="Stretch" Click="Pull_Click" IsEnabled="False" AutomationProperties.AutomationId="PullNow"/>
        <Button x:Name="PauseButton" Grid.Column="2" Content="启动同步" HorizontalAlignment="Stretch" Click="Pause_Click" AutomationProperties.AutomationId="PauseSync"/>
       </Grid>
       <ComboBox x:Name="DirectionBox" Header="同步方向" HorizontalAlignment="Stretch" SelectionChanged="Direction_Changed" AutomationProperties.AutomationId="SyncDirection">
        <ComboBoxItem Content="双向同步" Tag="both"/><ComboBoxItem Content="仅发送" Tag="upload"/><ComboBoxItem Content="仅接收" Tag="download"/>
       </ComboBox>
       <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="连接设置" Click="OpenSettings_Click"/>
        <Button x:Name="StopButton" Content="退出后台" Click="Stop_Click" IsEnabled="False"/>
       </StackPanel>
       <Border x:Name="InboxCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
         <TextBlock Text="敏感收件区" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="••••••••" FontSize="24"/>
         <TextBlock x:Name="InboxTime" Style="{StaticResource Note}"/>
         <TextBlock Text="此内容未写入系统剪贴板。关闭历史记录时，仍可使用当前收件项。" Style="{StaticResource Note}"/>
         <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="复制到剪贴板" Click="CopyInbox_Click"/><Button Content="删除" Click="ClearInbox_Click"/></StackPanel>
        </StackPanel>
       </Border>
       <Expander x:Name="HistoryPanel" Header="剪贴板历史" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="History_Expanding" AutomationProperties.AutomationId="HistoryPanel">
        <StackPanel Spacing="12">
         <TextBlock x:Name="HistoryNote" Text="历史默认关闭。可在设置中开启，本地记录会加密保存。" Style="{StaticResource Note}"/>
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="HistorySearch" PlaceholderText="搜索历史内容" MaxLength="256" AutomationProperties.Name="搜索历史"/>
          <ComboBox x:Name="HistoryScope" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="全部"/><ComboBoxItem Content="收藏"/></ComboBox>
          <Button Grid.Column="2" Content="搜索" Click="SearchHistory_Click"/>
         </Grid>
         <ListView x:Name="HistoryList" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="380" HorizontalContentAlignment="Stretch">
          <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="8" Padding="0,8" HorizontalAlignment="Stretch">
           <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
           <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="复制" Tag="{Binding Id}" Click="CopyHistory_Click"/><Button Content="{Binding FavoriteLabel}" Tag="{Binding Id}" Click="FavoriteHistory_Click"/><Button Content="删除" Tag="{Binding Id}" Click="DeleteHistory_Click"/></StackPanel>
          </StackPanel></DataTemplate></ListView.ItemTemplate>
         </ListView>
         <TextBlock x:Name="EmptyHistory" Text="暂无历史记录" Style="{StaticResource Note}"/>
         <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="PreviousHistory" Content="上一页" Click="PreviousHistory_Click"/><Button x:Name="NextHistory" Content="下一页" Click="NextHistory_Click"/><Button Content="清空历史" Click="ClearHistory_Click"/><TextBlock x:Name="HistoryCount" VerticalAlignment="Center"/></StackPanel>
        </StackPanel>
       </Expander>
       <TextBlock Text="已启动的同步会在关闭窗口后继续运行。双击托盘图标可再次打开，托盘菜单可暂停或退出。" Style="{StaticResource Note}"/>
      </StackPanel>
      <StackPanel x:Name="AppearancePage" Visibility="Collapsed" Spacing="20">
       <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="保留 Omaclipsync 的简洁布局，使用 Windows 原生控件与系统强调色。" Style="{StaticResource Note}"/>
       <ComboBox x:Name="ThemeChoice" Header="主题" HorizontalAlignment="Stretch" SelectionChanged="Appearance_Changed" AutomationProperties.AutomationId="ThemeChoice"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox>
       <ComboBox x:Name="FontChoice" Header="文字大小" HorizontalAlignment="Stretch" SelectionChanged="Appearance_Changed" AutomationProperties.AutomationId="FontChoice"><ComboBoxItem Content="标准" Tag="14"/><ComboBoxItem Content="较大" Tag="16"/><ComboBoxItem Content="大" Tag="18"/></ComboBox>
       <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="12"><TextBlock Text="预览" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="剪贴板已连接，可以开始同步。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="发送"/><Button Content="接收"/><Button Content="暂停"/></StackPanel></StackPanel></Border>
       <TextBlock Text="更改会立即生效，并在下次打开时保留。" Style="{StaticResource Note}"/>
      </StackPanel>
      <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="20">
       <TextBlock Text="设置" Style="{StaticResource SectionTitle}"/>
       <Expander Header="开机自启与后台" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="StartupSection">
        <StackPanel Spacing="12"><ToggleSwitch x:Name="StartupToggle" Header="登录 Windows 后自动启动同步" OnContent="开启" OffContent="关闭" Toggled="Startup_Toggled" AutomationProperties.AutomationId="StartAtLogin"/>
         <TextBlock Text="在当前用户登录后启动后台，不弹出主窗口，并保留暂停状态。关闭此选项不会停止本次正在运行的同步。" Style="{StaticResource Note}"/>
         <TextBlock x:Name="StartupState" Style="{StaticResource Note}" AutomationProperties.AutomationId="StartupState"/>
         <Button Content="打开 Windows 启动应用设置" Click="WindowsStartup_Click"/>
         <TextBlock Text="Windows 的启动应用设置和组织策略可能限制自启权限。" Style="{StaticResource Note}"/>
        </StackPanel>
       </Expander>
       <Expander Header="服务端与账户" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="14"><TextBox x:Name="ServerBox" Header="服务端地址" PlaceholderText="https://sync.example.com" InputScope="Url" MaxLength="2048" AutomationProperties.AutomationId="ServerUrl"/><TextBox x:Name="UserBox" Header="账户" PlaceholderText="服务端用户名" MaxLength="256"/><PasswordBox x:Name="PasswordBox" Header="密码" PlaceholderText="首次连接或重新配对时填写" MaxLength="1024"/>
         <TextBlock Text="密码仅用于配对，不会保存在配置文件中。已经配对时可留空。" Style="{StaticResource Note}"/>
         <Button x:Name="ConnectButton" Content="连接并启动" Style="{ThemeResource AccentButtonStyle}" Click="Connect_Click"/>
        </StackPanel>
       </Expander>
       <Expander Header="同步与隐私" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="14"><ToggleSwitch x:Name="SensitiveToggle" Header="同步已标记的敏感文本" OnContent="开启" OffContent="关闭"/>
         <TextBlock Text="默认关闭。部分应用可能不标记敏感内容，因此不能识别所有敏感信息。收到的敏感文本仅存入应用内收件区，不会自动写入系统剪贴板。" Style="{StaticResource Note}"/>
         <NumberBox x:Name="IntervalBox" Header="备用检查间隔（秒）" Minimum="30" Maximum="300" SpinButtonPlacementMode="Compact" Value="60"/>
         <TextBlock Text="正常连接时使用实时通知，此间隔用于备用检查。" Style="{StaticResource Note}"/>
         <ComboBox x:Name="FilterBox" Header="文本过滤" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="关闭" Tag="off"/><ComboBoxItem Content="黑名单：匹配时阻止" Tag="blacklist"/><ComboBoxItem Content="白名单：匹配时允许" Tag="whitelist"/></ComboBox>
         <TextBox x:Name="PatternsBox" Header="正则表达式（每行一条，最多 32 条）" AcceptsReturn="True" TextWrapping="NoWrap" MaxLength="16384" MinHeight="88"/>
         <ToggleSwitch x:Name="FilterDownloads" Header="过滤规则也用于接收" OnContent="开启" OffContent="关闭"/>
         <TextBox x:Name="FilterTestText" Header="测试文本" MaxLength="8192"/><Button Content="测试过滤规则" Click="TestFilter_Click"/><TextBlock x:Name="FilterTestResult" Style="{StaticResource Note}"/>
        </StackPanel>
       </Expander>
       <Expander AutomationProperties.AutomationId="HistorySettingsSection" Header="历史记录与清理" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="14"><ToggleSwitch x:Name="HistoryToggle" AutomationProperties.AutomationId="HistoryEnabled" Header="保存剪贴板历史" OnContent="开启" OffContent="关闭"/>
         <TextBlock Text="默认关闭。开启后在本机加密保存；关闭后停止新增，已有记录仍按期限清理。敏感文本不会进入普通历史列表。" Style="{StaticResource Note}"/>
         <NumberBox x:Name="HistoryLimitBox" Header="普通历史条数上限" Minimum="1" Maximum="1000" Value="50" SpinButtonPlacementMode="Compact"/>
         <NumberBox x:Name="HistoryDaysBox" AutomationProperties.AutomationId="HistoryDays" Header="保留天数" Minimum="1" Maximum="365" Value="7" SpinButtonPlacementMode="Compact"/>
         <TextBlock Text="默认保留 7 天，自动清理过期记录。收藏最多 50 条，保留至手动删除；敏感收件项按保留天数清理。单条历史最多 1 MiB，总正文最多 16 MiB，超限不影响文本同步。" Style="{StaticResource Note}"/>
         <Button Content="清空本地历史" Click="ClearHistory_Click"/>
        </StackPanel>
       </Expander>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SaveSettingsButton" Content="保存同步设置" Style="{ThemeResource AccentButtonStyle}" Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveSyncSettings"/><Button AutomationProperties.AutomationId="ReloadSettings" Content="重新载入" Click="ReloadSettings_Click"/></StackPanel>
       <Expander Header="关于与诊断" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12"><TextBlock Text="RustClipSync 0.2.0" FontWeight="SemiBold"/><TextBlock Text="与 Android 输入法和 Omaclipsync 使用同一同步协议。界面关闭后，后台同步独立运行。" Style="{StaticResource Note}"/>
         <StackPanel Orientation="Horizontal" Spacing="8"><HyperlinkButton Content="服务端" NavigateUri="https://github.com/Infinifar/rustclipsync-server"/><HyperlinkButton Content="Android 输入法" NavigateUri="https://github.com/Infinifar/fcitx5-android-bibi-keyboard"/><HyperlinkButton Content="Omaclipsync" NavigateUri="https://github.com/Infinifar/omaclipsync"/></StackPanel>
         <Button Content="导出脱敏诊断" Click="Diagnostics_Click"/><TextBlock x:Name="DiagnosticsResult" IsTextSelectionEnabled="True" Style="{StaticResource Note}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Grid>
    </Grid>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
