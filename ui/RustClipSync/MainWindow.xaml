<Window x:Class="RustClipSync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RustClipSync">
 <ScrollViewer>
  <Grid x:Name="Root" Padding="32" RowSpacing="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="16">
    <Image Source="Assets/rustclipsync.png" Width="64" Height="64" AutomationProperties.Name="RustClipSync 图标"/>
    <StackPanel VerticalAlignment="Center" Spacing="4">
     <TextBlock Text="RustClipSync" Style="{ThemeResource TitleTextBlockStyle}"/>
     <TextBlock Text="连接您的电脑和手机剪贴板" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="1" Spacing="16">
    <TextBlock Text="连接服务端" Style="{ThemeResource SubtitleTextBlockStyle}"/>
    <TextBox x:Name="ServerBox" Header="服务端地址" PlaceholderText="https://sync.example.com" InputScope="Url" MaxLength="2048"/>
    <TextBox x:Name="UserBox" Header="账户" PlaceholderText="服务端用户名" MaxLength="256"/>
    <PasswordBox x:Name="PasswordBox" Header="密码" PlaceholderText="首次连接时输入账户密码" MaxLength="1024"/>
    <TextBlock Text="密码仅用于设备配对，不会保存在配置文件中。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Button x:Name="ConnectButton" Content="连接并启动" Style="{ThemeResource AccentButtonStyle}" Click="Connect_Click"/>
     <Button x:Name="StartButton" Content="启动同步" Click="Start_Click" IsEnabled="False"/>
     <Button x:Name="StopButton" Content="停止同步" Click="Stop_Click"/>
     <ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False"/>
    </StackPanel>
    <InfoBar x:Name="Notice" IsOpen="True" IsClosable="False" Severity="Informational"
      Title="首次使用" Message="填写服务端地址和账户密码，然后连接。"/>
   </StackPanel>
   <StackPanel Grid.Row="3" Spacing="8">
    <TextBlock Text="关闭本窗口后，Rust 后台会继续同步。可从系统托盘查看状态、暂停或退出。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <HyperlinkButton Content="服务端" NavigateUri="https://github.com/Infinifar/rustclipsync-server"/>
     <HyperlinkButton Content="Android 客户端" NavigateUri="https://github.com/Infinifar/fcitx5-android-bibi-keyboard"/>
     <HyperlinkButton Content="Omaclipsync" NavigateUri="https://github.com/Infinifar/omaclipsync"/>
    </StackPanel>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</Window>
